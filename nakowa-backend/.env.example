# =================================
# NAKOWA MVP - Configuration Backend
# =================================

# =================================
# DATABASE CONFIGURATION
# =================================

# Supabase (Production/Cloud)
DATABASE_URL="postgresql://postgres:[VOTRE_MOT_DE_PASSE]@db.[PROJECT_ID].supabase.co:5432/postgres"

# Base locale PostgreSQL (Développement)
# DATABASE_URL="postgresql://username:password@localhost:5432/nakowa_dev?schema=public"

# =================================
# AUTHENTICATION & SECURITY
# =================================

# JWT Secret - Générez une clé secrète longue et aléatoire
JWT_SECRET="votre-cle-secrete-jwt-tres-longue-et-aleatoire"

# Durée de validité du token JWT
JWT_EXPIRES_IN="24h"

# =================================
# SERVER CONFIGURATION
# =================================

# Port d'écoute du serveur backend
PORT=3000

# Environment (development, production, test)
NODE_ENV="development"

# =================================
# CORS & FRONTEND
# =================================

# URL du frontend Angular
FRONTEND_URL="http://localhost:4200"

# =================================
# EXTERNAL APIS
# =================================

# Google Maps API Key (pour géolocalisation)
GOOGLE_MAPS_API_KEY="your-google-maps-api-key-here"

# =================================
# LOGS & MONITORING
# =================================

# Niveau de logs
LOG_LEVEL="info"

# =================================
# EMAIL CONFIGURATION (futur)
# =================================

# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="votre-email@domain.com"
# SMTP_PASSWORD="votre-mot-de-passe-app"

# =================================
# INSTRUCTIONS
# =================================
# 1. Copiez ce fichier vers .env
# 2. Remplacez toutes les valeurs par les vraies
# 3. Ne jamais commiter le fichier .env