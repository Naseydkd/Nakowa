# ------------------------------------------------------------------------------
# 🔴 VARIABLES OBLIGATOIRES
# ------------------------------------------------------------------------------

# DATABASE - Supabase Connection Pooling (port 6543)
DATABASE_URL="postgresql://postgres.mwhrglgyblvytldciwtn:JeCommenceParBismillahEtJefiniParAlhamdoullilah@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DATABASE - Supabase Direct Connection pour migrations (port 5432)
DIRECT_DATABASE_URL="postgresql://postgres.mwhrglgyblvytldciwtn:JeCommenceParBismillahEtJefiniParAlhamdoullilah@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# JWT - Clé secrète (64+ caractères recommandés)
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="2c649ef39fd08d8f722ce72daabd09ae69e905865cb0acb4495f9ec7f0860e88"

# JWT - Durée de validité des tokens
JWT_EXPIRES_IN="24h"

# SERVER - Mode production
NODE_ENV="production"

# SERVER - Port (Vercel gère automatiquement, mais gardé pour compatibilité)
PORT="3000"

# CORS - URL du frontend (remplacer par votre domaine Vercel)
FRONTEND_URL="https://nakowa-three.vercel.app"

# CRON - Secret pour protéger les endpoints cron
# Générer avec : node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET="6feba255cec465528ab601db84ccb1e3885c4de9b753ac37"


# ------------------------------------------------------------------------------
# 🟡 VARIABLES OPTIONNELLES (Fonctionnalité Email Reports)
# ------------------------------------------------------------------------------

# EMAIL - Configuration SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-production-email@gmail.com"
SMTP_PASSWORD="your-app-specific-password"

# EMAIL - Destinataires des rapports
REPORT_EMAIL_RECIPIENTS="admin@nakowa.com,manager@nakowa.com"


# ------------------------------------------------------------------------------
# 📝 INSTRUCTIONS CONFIGURATION VERCEL
# ------------------------------------------------------------------------------
# 
# 1. Aller sur https://vercel.com/dashboard
# 2. Sélectionner votre projet Nakowa
# 3. Aller dans Settings → Environment Variables
# 4. Ajouter CHAQUE variable ci-dessus individuellement :
#    - Name: DATABASE_URL
#    - Value: [votre valeur Supabase]
#    - Environments: ☑ Production ☐ Preview ☐ Development
#    - ☑ Encrypt (pour les secrets)
# 5. Répéter pour TOUTES les variables
# 6. Redéployer l'application
#
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 🔒 SÉCURITÉ - CHECKLIST
# ------------------------------------------------------------------------------
#
# ✅ Nouveaux secrets JWT et CRON générés (différents du développement)
# ✅ DATABASE_URL utilise connection pooling (port 6543)
# ✅ DIRECT_DATABASE_URL utilise connexion directe (port 5432)
# ✅ FRONTEND_URL correspond à votre domaine Vercel exact
# ✅ Secrets marqués "Encrypt" dans Vercel Dashboard
# ✅ Ce fichier n'est PAS commité dans Git (.gitignore)
# ✅ Vraies valeurs stockées uniquement dans Vercel Dashboard
#
# ------------------------------------------------------------------------------

