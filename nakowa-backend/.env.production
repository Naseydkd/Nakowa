# Production Environment Variables
# Copy this file to .env for production deployment

# Database - Use your production PostgreSQL or Supabase URL
DATABASE_URL="postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres"

# JWT - Generate strong secret for production
JWT_SECRET="your-super-secure-jwt-secret-here-change-this"
JWT_EXPIRES_IN="24h"

# Server
PORT=3000
NODE_ENV="production"

# Frontend URL - Update with your production frontend domain
FRONTEND_URL="https://your-nakowa-app.com"

# Google Maps API Key
GOOGLE_MAPS_API_KEY="your-production-google-maps-api-key"

# Optional: Logging level for production
LOG_LEVEL="warn"