# =====================================
# NAKOWA MVP - Variables d'environnement
# =====================================

# =================================
# BASE DE DONNÉES
# =================================

# Supabase (recommandé pour MVP)
DATABASE_URL="postgresql://postgres:[MOT_DE_PASSE]@db.[PROJECT_ID].supabase.co:5432/postgres"

# PostgreSQL local (développement)
# DATABASE_URL="postgresql://username:password@localhost:5432/nakowa_dev?schema=public"

# =================================
# AUTHENTIFICATION
# =================================

# Clé secrète JWT (générez une clé longue et aléatoire)
JWT_SECRET="nakowa-mvp-secret-key-production-2024-changez-moi"
JWT_EXPIRES_IN="24h"

# =================================
# SERVEUR
# =================================

PORT=3000
NODE_ENV="development"

# =================================
# FRONTEND & CORS
# =================================

FRONTEND_URL="http://localhost:4200"

# =================================
# APIs EXTERNES
# =================================

# Google Maps (pour géolocalisation Niamey)
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# =================================
# INSTRUCTIONS DE CONFIGURATION
# =================================

# ÉTAPES :
# 1. Copiez ce fichier vers nakowa-backend/.env
# 2. Remplacez les valeurs [PLACEHOLDER] par les vraies
# 3. Créez votre projet Supabase sur https://supabase.com
# 4. Récupérez votre DATABASE_URL dans Settings > Database
# 5. Lancez les migrations : npx prisma migrate deploy

# SÉCURITÉ :
# - Ne jamais commiter le fichier .env
# - Utilisez des clés JWT longues (64+ caractères)
# - Changez les mots de passe par défaut

# =================================
# EMAIL & RAPPORTS AUTOMATIQUES
# =================================

# Configuration SMTP pour l'envoi d'emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# Destinataires pour les rapports (séparés par des virgules)
REPORT_EMAIL_RECIPIENTS="admin@nakowa.com,manager@nakowa.com"

# =================================
# CRON JOBS & VERCEL
# =================================

# Secret pour sécuriser les endpoints Cron (générez une clé aléatoire longue)
CRON_SECRET="your-secure-cron-secret-change-in-production"
